# ── OpenAI-compatible API ─────────────────────────────────────────────
# Required for LLM-based entity/relationship extraction. Without a key the
# app runs in statistical-only mode (keyword + co-occurrence graph).
OPENAI_API_KEY=

# Point at any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, ...):
#   local Ollama:   http://localhost:11434/v1
#   LM Studio:      http://localhost:1234/v1
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# ── Storage & tuning ──────────────────────────────────────────────────
DATA_DIR=./data
MAX_UPLOAD_MB=50
MAX_GRAPH_NODES=600
MAX_GRAPH_EDGES=2500
CHUNK_CHARS=4000
CHUNK_OVERLAP=200
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
LLM_CONCURRENCY=4
EXTRACTION_MODE=balanced
LLM_CHUNK_FRACTION=0.35
LLM_MIN_CHUNKS=12
LLM_MAX_CHUNKS=250
